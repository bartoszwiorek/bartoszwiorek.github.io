# Railway provides PORT automatically. Used by the production server.
PORT=3000
# Public Cookiebot Domain Group ID. Empty means consent manager and analytics are disabled.
COOKIEBOT_ID=
# Example: https://analytics.example.com (your separately hosted Ackee instance)
ACKEE_SERVER=
# Public domain UUID from your Ackee dashboard.
ACKEE_DOMAIN_ID=
