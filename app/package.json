{
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "name": "bartosz-wiorek-portfolio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vitepress build",
    "start": "node --env-file-if-exists=.env scripts/server.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test scripts/*.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
